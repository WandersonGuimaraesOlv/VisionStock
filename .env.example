# Copie para .env e preencha. Nunca faça commit do .env.

# Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_TABELA_LEITURAS=leituras_almox

# Chave compartilhada entre o app e o backend de drone (gere com: openssl rand -hex 24)
API_KEY=

# Porta local onde o app fica disponível para o proxy HTTPS do servidor
ALMOX_PORTA=8080

# Backend de drone
LIMITE_UPLOAD_MB=600
MAX_PROCESSAMENTOS=1

# Só para desenvolvimento (npm run dev) com o backend em outra porta/endereço:
# VITE_API_URL=http://localhost:8000
# VITE_API_KEY=mesma-chave-do-API_KEY
