# observar = ninguém é barrado, só registra no Histórico quem seria; bloquear = aplica as permissões
ACESSO_MODO=observar
# Duração do login, em horas
ACESSO_SESSAO_HORAS=12
# 1 só quando todo acesso for por HTTPS (com 1, o login não funciona por http://)
ACESSO_COOKIE_SEGURO=0
ACESSO_PORTA=8093
# Base de crachás do VisionStock (para "Importar crachás"); o implantar.sh copia do ~/visionstock/.env
ACESSO_SUPABASE_URL=
ACESSO_SUPABASE_CHAVE=
